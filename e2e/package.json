{
  "name": "@sualive/e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ --ignore-pattern test-results --ignore-pattern playwright-report --ignore-pattern blob-report .",
    "test": "node -e \"\"",
    "test:related": "node -e \"\"",
    "test:ci": "node -e \"\"",
    "e2e": "playwright test",
    "build": "node -e \"\""
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@sualive/config": "workspace:*",
    "@types/node": "22.20.5"
  }
}
