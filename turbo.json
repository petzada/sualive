{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "lint": {},
    "test": {},
    "test:related": {},
    "test:ci": {},
    "e2e": { "cache": false },
    "@sualive/e2e#e2e": {
      "dependsOn": ["@sualive/api#build"],
      "cache": false,
      "passThroughEnv": ["CI", "PLAYWRIGHT_*", "E2E_PORT"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"],
      "passThroughEnv": ["SENTRY_AUTH_TOKEN"]
    },
    "@sualive/api#build": {
      "dependsOn": ["^build", "@sualive/web#build"],
      "outputs": ["dist/**"]
    }
  }
}
