{
  "name": "@sualive/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --cache --cache-location node_modules/.cache/eslint/ .",
    "test": "vitest --run --passWithNoTests",
    "test:related": "vitest related --run --passWithNoTests",
    "test:ci": "vitest --run --passWithNoTests",
    "e2e": "node -e \"\"",
    "build": "vite build"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@heroui/react": "3.2.7",
    "@heroui/styles": "3.2.7",
    "@sentry/react": "11.12.0",
    "@sualive/config": "workspace:*",
    "@sualive/protocol": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@sentry/vite-plugin": "11.12.0",
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "4.1.12"
  }
