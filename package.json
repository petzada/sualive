{
  "name": "sualive",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test --concurrency=1",
    "test:related": "node scripts/test-related.mjs",
    "test:ci": "turbo run test:ci --concurrency=1",
    "e2e": "turbo run e2e --concurrency=1",
    "build": "turbo run build",
    "format": "prettier --write .",
    "prepare": "node -e \"if (require('fs').existsSync('.git')) require('child_process').execSync('lefthook install', { stdio: 'inherit' })\""
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.10.1",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
